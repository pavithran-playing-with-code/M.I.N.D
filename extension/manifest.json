{
  "manifest_version": 3,
  "name": "M.I.N.D",
  "version": "1.0.0",
  "description": "Lets your M.I.N.D voice assistant see your tabs and tell you when a Claude, ChatGPT or Gemini answer is done.",
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*", "https://chatgpt.com/*", "https://chat.openai.com/*", "https://gemini.google.com/*"],
      "js": ["chat.js"],
      "run_at": "document_idle"
    }
  ]
}
