# Copy this file to .env and put in your free keys

# M.I.N.D Live, the main brain (and backup brains): https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Hearing and backup brains: https://console.groq.com/keys
GROQ_API_KEY=your_key_here

# Gmail (optional): your address + an app password from https://myaccount.google.com/apppasswords
# (needs 2-Step Verification). More accounts: repeat both lines. Empty = Gmail off.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
